# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is committed: this is an application, and the server build
# should use exactly the dependency versions that were tested.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# OS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
*.swo

# Claude Code: shared project settings and hooks are committed; personal
# overrides go in settings.local.json (or CLAUDE.local.md), which stay local.
.claude/*
!.claude/settings.json
!.claude/hooks/
CLAUDE.local.md

# Generated content module
src/content.rs

# Generated by build.rs on each build (feed/sitemap from content/,
# robots.txt and site.webmanifest from site.yaml)
public/feed.xml
public/sitemap.xml
public/robots.txt
public/site.webmanifest

# Temporary docs
docs/temp/
/.tool-cache/
